{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interpret_valuation_probe 判断块（v1）：最小闭环临时单元，输出完整主判断形状",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "unit_version",
    "stock_code",
    "trade_date",
    "dimension",
    "conclusion",
    "confidence",
    "facts_used",
    "logic_tags",
    "data_gaps",
    "direction",
    "key_levels",
    "thesis",
    "verification_rules"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "const": "interpret_valuation_probe",
      "description": "必须与执行单元一致（SchemaValidator 额外硬比对）"
    },
    "unit_version": {
      "type": "string",
      "pattern": "^v\\d+(\\.\\d+)?$"
    },
    "stock_code": {
      "type": "string",
      "pattern": "^\\d{6}\\.(SH|SZ|BJ)$"
    },
    "trade_date": {
      "type": "string",
      "pattern": "^\\d{8}$"
    },
    "dimension": {
      "type": "string",
      "enum": ["valuation"]
    },
    "conclusion": {
      "type": "string",
      "enum": ["明显偏低", "偏低", "合理", "偏高", "明显偏高"]
    },
    "confidence": {
      "type": "string",
      "enum": ["高", "中", "低"]
    },
    "facts_used": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "value", "unit"],
        "properties": {
          "metric": {
            "type": "string",
            "pattern": "^valuation\\."
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "logic_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "horizon_days"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["bullish", "bearish", "neutral", "conditional"]
        },
        "horizon_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250
        },
        "expire_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "target_note": {
          "type": "string"
        }
      }
    },
    "key_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support", "resistance"],
      "properties": {
        "support": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "resistance": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "stop_loss": {
          "type": ["number", "null"]
        },
        "invalidation_condition": {
          "type": "string"
        }
      }
    },
    "thesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bull_core", "bear_core", "current_side", "confidence"],
      "properties": {
        "bull_core": {
          "type": "string",
          "minLength": 1
        },
        "bear_core": {
          "type": "string",
          "minLength": 1
        },
        "current_side": {
          "type": "string",
          "enum": ["bull", "bear", "neutral"]
        },
        "confidence": {
          "type": "string",
          "enum": ["高", "中", "低"]
        }
      }
    },
    "verification_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_type", "params", "on_hit"],
        "properties": {
          "rule_type": {
            "type": "string",
            "enum": ["price_touch", "price_break", "direction_fail", "logic_invalid"]
          },
          "target": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "on_hit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
